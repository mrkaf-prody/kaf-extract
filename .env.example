# Database (PostgreSQL by default, use sqlite for local dev)
DATABASE_URL=postgresql+asyncpg://kafextract:kafextract@localhost:5432/kafextract
# For local SQLite dev:
# DATABASE_URL=sqlite+aiosqlite:///./data/kaf-extract.db

# JWT Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# API Key (legacy dev key, for non-JWT API access)
DEV_API_KEY=kaf-extract-dev-key-change-in-production

# Browser
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# Crawl4AI
CRAWL4AI_HEADLESS=true
CRAWL4AI_PAGE_TIMEOUT_MS=30000

# Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=kimi-k2.6:cloud

# Server
HOST=0.0.0.0
PORT=8000

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
