# Database
DATABASE_URL=sqlite:///./data/kaf-extract.db

# API Key (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# Default for dev: kaf-extract-dev-key-change-in-production
DEV_API_KEY=kaf-extract-dev-key-change-in-production

# Browser
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# Server
HOST=0.0.0.0
PORT=8000
