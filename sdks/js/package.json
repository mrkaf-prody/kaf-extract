{
  "name": "kaf-extract",
  "version": "1.0.0",
  "description": "Official JavaScript SDK for Kaf Extract — AI-powered web data extraction API",
  "license": "MIT",
  "author": "Kaf Center <hermizy@kafcenter.com>",
  "homepage": "https://extract.kafcenter.com",
  "repository": "github:mrkaf-prody/kaf-extract",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "keywords": [
    "web-scraping",
    "data-extraction",
    "crawl4ai",
    "ai-extraction",
    "kaf-extract"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
